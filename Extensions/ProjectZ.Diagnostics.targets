<Project>
  <Import Project="ProjectZ.WindowsRuntime.targets" Condition="'$(ProjectZWindowsRuntimeSelectionImported)' != 'true'" />
  <Import Project="$(MSBuildThisFileDirectory)..\Project Z XAML Codegen\ProjectZ.RenderingQuality.targets"
          Condition="'$(ProjectZRenderingQualityIntegrationImported)' != 'true' and Exists('$(MSBuildThisFileDirectory)..\Project Z XAML Codegen\ProjectZ.RenderingQuality.targets')" />
  <Import Project="$(MSBuildThisFileDirectory)..\tools\xaml-codegen\ProjectZ.RenderingQuality.targets"
          Condition="'$(ProjectZRenderingQualityIntegrationImported)' != 'true' and Exists('$(MSBuildThisFileDirectory)..\tools\xaml-codegen\ProjectZ.RenderingQuality.targets')" />
  <PropertyGroup>
    <ProjectZXamlGeneratorDll Condition="'$(ProjectZXamlGeneratorDll)' == '' and Exists('$(MSBuildThisFileDirectory)..\tools\xaml-codegen\ProjectZ.XamlCodegen.dll')">$(MSBuildThisFileDirectory)..\tools\xaml-codegen\ProjectZ.XamlCodegen.dll</ProjectZXamlGeneratorDll>
    <ProjectZNativeXamlTool Condition="'$(ProjectZNativeXamlTool)' == '' and '$(ProjectZXamlGeneratorDll)' != ''">$(ProjectZXamlGeneratorDll)</ProjectZNativeXamlTool>
    <_ProjectZShaderWorker>$(MSBuildThisFileDirectory)..\lib\net8.0-windows7.0\ProjectZ.ShaderEditor.dll</_ProjectZShaderWorker>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\tools\xaml-codegen\ProjectZ.NativeXaml.targets"
          Condition="'$(ProjectZNativeXamlIntegrationImported)' != 'true' and Exists('$(MSBuildThisFileDirectory)..\tools\xaml-codegen\ProjectZ.NativeXaml.targets')" />
  <ItemGroup>
  </ItemGroup>
  <Target Name="CopyProjectZShaderWorker" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(CopyLocalLockFileAssemblies)' != 'true' and Exists('$(_ProjectZShaderWorker)')">
    <Copy SourceFiles="$(_ProjectZShaderWorker)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <!-- Source references receive these files from the framework project itself.
         Only package consumers need an explicit copy from the package root. -->
    <Content Include="$(MSBuildThisFileDirectory)..\ThirdParty\ProjectZSans\*" Pack="false" Condition="!Exists('$(MSBuildThisFileDirectory)..\Project Z Windows.vbproj')">
      <Link>ThirdParty\ProjectZSans\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)ProjectZ.ShaderCompiler\*" Pack="false">
      <Link>ProjectZ.ShaderCompiler\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)ProjectZ.ShaderEditor.Worker.runtimeconfig.json" Pack="false"
             Condition="Exists('$(MSBuildThisFileDirectory)ProjectZ.ShaderEditor.Worker.runtimeconfig.json')">
      <Link>ProjectZ.ShaderEditor.Worker.runtimeconfig.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CollectProjectZPackagedShaderCompiler" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectZWindowsRuntime">
    <PropertyGroup Condition="'$(_ProjectZWindowsRuntimeIdentifier)' != ''">
      <_ProjectZShaderCompilerSubdirectory>windows-$(_ProjectZWindowsRuntimeIdentifier.Substring(4))</_ProjectZShaderCompilerSubdirectory>
    </PropertyGroup>
    <ItemGroup Condition="'$(_ProjectZShaderCompilerSubdirectory)' != ''">
      <Content Include="$(MSBuildThisFileDirectory)ProjectZ.ShaderCompiler/$(_ProjectZShaderCompilerSubdirectory)/*"
               Link="ProjectZ.ShaderCompiler/$(_ProjectZShaderCompilerSubdirectory)/%(Filename)%(Extension)" Pack="false"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="CollectProjectZNativeGraphicsRuntime" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectZWindowsRuntime">
    <ItemGroup Condition="'$(_ProjectZWindowsRuntimeIdentifier)' != ''">
      <_ProjectZNativePayload Include="@(_ProjectZNativeRuntimeSource->WithMetadataValue('RuntimeIdentifier', '$(_ProjectZWindowsRuntimeIdentifier)'))" />
      <_ProjectZNativePayload Include="$(MSBuildThisFileDirectory)../tools/native/$(_ProjectZWindowsRuntimeIdentifier)/*" />
      <None Include="@(_ProjectZNativePayload)" Link="ProjectZ.Native/$(_ProjectZWindowsRuntimeIdentifier)/%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    </ItemGroup>
  </Target>
  <!-- Select the patched native runtime before the SDK bundles/copies publish
       files. Copying it after Publish leaves the upstream DLL inside a bundle
       and ships an unnecessary second copy under ProjectZ.Native. -->
  <Target Name="SelectProjectZPublishedNativeRuntime" AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="_HandleFileConflictsForPublish" DependsOnTargets="ResolveProjectZWindowsRuntime">
    <ItemGroup Condition="'$(_ProjectZWindowsRuntimeIdentifier)' != ''">
      <_ProjectZPublishedNative Include="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.RelativePath)' == 'ProjectZ.Native\$(_ProjectZWindowsRuntimeIdentifier)\mgruntime.dll' or '%(ResolvedFileToPublish.RelativePath)' == 'ProjectZ.Native/$(_ProjectZWindowsRuntimeIdentifier)/mgruntime.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'@(_ProjectZPublishedNative)' != '' and ('%(ResolvedFileToPublish.RelativePath)' == 'mgruntime.dll' or '%(ResolvedFileToPublish.RelativePath)' == 'ProjectZ.Native\$(_ProjectZWindowsRuntimeIdentifier)\mgruntime.dll' or '%(ResolvedFileToPublish.RelativePath)' == 'ProjectZ.Native/$(_ProjectZWindowsRuntimeIdentifier)/mgruntime.dll')" />
      <ResolvedFileToPublish Include="@(_ProjectZPublishedNative)" RelativePath="mgruntime.dll" />
    </ItemGroup>
  </Target>
  <!-- A separate payload path avoids duplicate publish-asset conflicts. -->
  <Target Name="UseProjectZNativeGraphicsRuntime" AfterTargets="Build" DependsOnTargets="ResolveProjectZWindowsRuntime">
    <Copy SourceFiles="$(TargetDir)ProjectZ.Native/$(_ProjectZWindowsRuntimeIdentifier)/mgruntime.dll" DestinationFiles="$(TargetDir)mgruntime.dll"
          Condition="'$(_ProjectZWindowsRuntimeIdentifier)' != '' and Exists('$(TargetDir)ProjectZ.Native/$(_ProjectZWindowsRuntimeIdentifier)/mgruntime.dll')" />
  </Target>
  <!-- ProjectZ.Diagnostics.exe carries its own CLR. Never substitute a host's
       runtimeconfig/deps: single-file hosts need not extract their CLR beside it. -->
</Project>
