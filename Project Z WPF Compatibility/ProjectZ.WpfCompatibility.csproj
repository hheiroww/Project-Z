<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ProjectZ.WpfCompatibility</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.3124.44,)" />
    <ProjectReference Include="../Project Z Windows.vbproj" Condition="'$(ProjectZFrameworkPackageVersion)' == ''" />
    <PackageReference Include="ProjectZ" Version="[$(ProjectZFrameworkPackageVersion)]" Condition="'$(ProjectZFrameworkPackageVersion)' != ''" />
  </ItemGroup>
</Project>
