<Project>
  <Import Project="../Extensions/ProjectZ.Package.props" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ProjectZ</RootNamespace>
    <AssemblyName>ProjectZ</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);42016;42312</NoWarn>
    <DefineConstants>$(DefineConstants),PROJECTZ_OPENGL=-1,PROJECTZ_DESKTOPGL=-1</DefineConstants>
    <ProjectZGraphicsBackend>OpenGL</ProjectZGraphicsBackend>
    <ProjectZRepositoryRoot>$(MSBuildThisFileDirectory)../</ProjectZRepositoryRoot>
    <PackageReadmeFile>DESKTOPGL.md</PackageReadmeFile>
    <PackageIcon>project-z-icon.png</PackageIcon>
    <Description>Project-Z scenes, native XAML, controls, vector text and GPU effects using MonoGame DesktopGL on $(ProjectZDesktopPlatform).</Description>
    <PackageReleaseNotes>First Linux and macOS packages, built from the shared VB.NET runtime with SDL input and OpenGL shaders. See DESKTOPGL.md for platform features and deployment.</PackageReleaseNotes>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeDesktopGLVectorText</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProjectZRepositoryRoot)Shared/**/*.vb" Exclude="$(ProjectZRepositoryRoot)Shared/Drawing/Designer/DesignTime/**/*.vb;$(ProjectZRepositoryRoot)Shared/Content/ColorFontLayers.vb" Link="Shared/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageReference Include="LibTessDotNet" Version="1.1.15" />
    <ProjectReference Include="$(ProjectZRepositoryRoot)Project Z Vector Text/ProjectZ.VectorText.csproj" PrivateAssets="all" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Shaders/XamlEffects.mgfx" LogicalName="ProjectZ.Resources.XamlEffects.mgfx" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Shaders/FXAA.mgfx" LogicalName="ProjectZ.Resources.FXAA.mgfx" />
    <None Include="$(ProjectZRepositoryRoot)docs/DESKTOPGL.md;$(ProjectZRepositoryRoot)THIRD-PARTY-NOTICES.md;$(ProjectZRepositoryRoot)Images/branding/project-z-icon.png" Pack="true" PackagePath="/" />
    <None Include="$(ProjectZRepositoryRoot)ThirdParty/ProjectZSans/OFL.txt;$(ProjectZRepositoryRoot)ThirdParty/ProjectZSans/README.md" Pack="true" PackagePath="ThirdParty/ProjectZSans/" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="ThirdParty/ProjectZSans/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
