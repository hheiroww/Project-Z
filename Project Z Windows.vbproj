<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Extensions/ProjectZ.Package.props" />
  <Import Project="Extensions/ProjectZ.DesktopCapture.Source.targets" />

  <PropertyGroup>
	<TargetFramework>net8.0-windows7.0</TargetFramework>
	<RootNamespace>ProjectZ</RootNamespace>
	<AssemblyName>ProjectZ</AssemblyName>
	<OptionStrict>On</OptionStrict>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<UseWindowsForms>true</UseWindowsForms>
	<UseWPF>true</UseWPF>
	<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
	<ImplicitUsings>enable</ImplicitUsings>
	<OutputType>Library</OutputType>
	<UseApplicationFramework>True</UseApplicationFramework>
	<SingleInstance>True</SingleInstance>
	<EnableVisualStyles>True</EnableVisualStyles>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsAsErrors>
    <PackageReleaseNotes>Smaller base runtime. Native crash capture, Assimp model importing, WebView2 hosting and XAML compiler tools are optional co-packages. Networking applications reference SocketJack directly. Managed error logging remains in the base runtime. See docs/MODULAR-PACKAGES.md for migration.</PackageReleaseNotes>
	<DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**;Project Z Linux Test\**</DefaultItemExcludes>
	<Title>Project Z</Title>
	<Description>An XNA UI Framework that runs on modern .NET 8.0</Description>
	<PackageReadmeFile>README.NuGet.md</PackageReadmeFile>
	<PackageIcon>project-z-icon.png</PackageIcon>
	<PackageProjectUrl>https://github.com/hheiroww/Project-Z</PackageProjectUrl>
	<ProjectZGraphicsBackend Condition="'$(ProjectZGraphicsBackend)' == ''">DirectX12</ProjectZGraphicsBackend>
	<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeProjectZVectorText</TargetsForTfmSpecificBuildOutput>
	<DefineConstants Condition="'$(ProjectZGraphicsBackend)' == 'DirectX12'">$(DefineConstants),PROJECTZ_DIRECTX12=-1</DefineConstants>
	<DefineConstants Condition="'$(ProjectZGraphicsBackend)' == 'DirectX11'">$(DefineConstants),PROJECTZ_DIRECTX11=-1</DefineConstants>
	<DefineConstants Condition="'$(ProjectZGraphicsBackend)' == 'OpenGL'">$(DefineConstants),PROJECTZ_OPENGL=-1</DefineConstants>
</PropertyGroup>

<ItemGroup>
	<!-- Import fixtures and converter outputs are separate consumers, never framework sources. -->
	<Compile Remove="artifacts\**" />
	<Compile Remove="tests\**" />
	<Page Remove="artifacts\**;Project Z XAML Codegen\**" />
	<EmbeddedResource Remove="artifacts\**" />
	<Compile Remove="obj\**" />
	<Compile Remove="packages\**" />
	<Compile Remove="Project Z Application\**" />
	<Compile Remove="Project Z Diagnostics\**" />
	<Compile Remove="Project Z WebView2\**" />
	<Compile Remove="Project Z Audio\**" />
	<Compile Remove="Project Z Test\**" />
	<Compile Remove="Project Z Tower Defense\**" />
	<Compile Remove="Project Z Video FX\**" />
	<Compile Remove="Project Z.sln.ide\**" />
	<Compile Remove="ProjectTemplate\**" />
	<Compile Remove="heirowSnap Project Z\**" />
	<Compile Remove="heirowSnap Protocol\**" />
	<Compile Remove="heirowSnap Legacy Settings\**" />
	<None Remove="obj\**" />
	<None Remove="packages\**" />
	<None Remove="Project Z Application\**" />
	<None Remove="Project Z Audio\**" />
	<None Remove="Project Z Test\**" />
	<None Remove="Project Z Tower Defense\**" />
	<None Remove="Project Z Video FX\**" />
	<None Remove="Project Z.sln.ide\**" />
	<None Remove="ProjectTemplate\**" />
	<None Remove="heirowSnap Project Z\**" />
	<None Remove="heirowSnap Protocol\**" />
	<None Remove="tests\**" />
	<Page Remove="obj\**" />
	<Page Remove="packages\**" />
	<Page Remove="Project Z Tower Defense\**" />
	<Page Remove="heirowSnap Project Z\**" />
	<Page Remove="heirowSnap Protocol\**" />
	<Page Remove="tests\**" />
	<Page Remove="ProjectTemplate\**" />
</ItemGroup>

<!-- MonoGame 3.8.5.1 native DX12 is the default. WindowsDX remains available
       as a migration fallback through -p:ProjectZGraphicsBackend=DirectX11. -->
<ItemGroup>
	<PackageReference Include="MonoGame.Framework.Native" Version="3.8.5.1" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX12'" />
	<PackageReference Include="MonoGame.Runtime.Windows.DX12" Version="3.8.5.1" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX12'" />
	<PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5.1" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX11'" />
	<PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" Condition="'$(ProjectZGraphicsBackend)' == 'OpenGL'" />
	<PackageReference Include="LibTessDotNet" Version="1.1.15" />
	<!-- Needed by the WindowsDX fallback's SharpDX dependency graph. -->
	<PackageReference Include="System.Net.Http" Version="4.3.4" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX11'" />
	<PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX11'" />
</ItemGroup>

<Target Name="ValidateProjectZGraphicsBackend" BeforeTargets="PrepareForBuild">
	<Error Condition="'$(ProjectZGraphicsBackend)' != 'DirectX12' and '$(ProjectZGraphicsBackend)' != 'DirectX11' and '$(ProjectZGraphicsBackend)' != 'OpenGL'" Text="ProjectZGraphicsBackend must be DirectX12, DirectX11 or OpenGL." />
</Target>

<ItemGroup>
	<ProjectReference Include="Project Z Vector Text\ProjectZ.VectorText.csproj" PrivateAssets="all" />
</ItemGroup>

  <!-- Vector text is required by the base UI. Optional features ship separately. -->
  <Target Name="IncludeProjectZVectorText">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)ProjectZ.VectorText.dll" />
    </ItemGroup>
  </Target>

  <!-- Project references retained as project references -->

  <!-- Keep resources -->
  <PropertyGroup>
    <XamlShaderProfile Condition="'$(ProjectZGraphicsBackend)' == 'DirectX12'">DirectX_12</XamlShaderProfile>
    <XamlShaderProfile Condition="'$(ProjectZGraphicsBackend)' == 'DirectX11'">DirectX_11</XamlShaderProfile>
    <XamlShaderProfile Condition="'$(ProjectZGraphicsBackend)' == 'OpenGL'">OpenGL</XamlShaderProfile>
    <XamlShaderDefines>$(ProjectZGraphicsBackend.ToUpperInvariant())</XamlShaderDefines>
    <XamlShaderDefines Condition="'$(ProjectZGraphicsBackend)' == 'OpenGL'">PROJECTZ_OPENGL</XamlShaderDefines>
  </PropertyGroup>
  <Target Name="CompileProjectZXamlShaders" BeforeTargets="PrepareResources" Inputs="Resources\XamlEffects.fx;Resources\DesktopBlur.fx;.config\dotnet-tools.json" Outputs="$(IntermediateOutputPath)XamlEffects.$(ProjectZGraphicsBackend).mgfx;$(IntermediateOutputPath)DesktopBlur.$(ProjectZGraphicsBackend).mgfx">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="dotnet tool run mgfxc -- &quot;$(MSBuildProjectDirectory)\Resources\XamlEffects.fx&quot; &quot;$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)XamlEffects.$(ProjectZGraphicsBackend).mgfx', '$(MSBuildProjectDirectory)'))&quot; /Profile:$(XamlShaderProfile) /Defines:$(XamlShaderDefines)" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="dotnet tool run mgfxc -- &quot;$(MSBuildProjectDirectory)/Resources/DesktopBlur.fx&quot; &quot;$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)DesktopBlur.$(ProjectZGraphicsBackend).mgfx', '$(MSBuildProjectDirectory)'))&quot; /Profile:$(XamlShaderProfile) /Defines:$(XamlShaderDefines)" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Target Name="CompileProjectZOpenGLFxaa" BeforeTargets="PrepareResources" Condition="'$(ProjectZGraphicsBackend)' == 'OpenGL'" DependsOnTargets="CompileProjectZXamlShaders" Inputs="Resources\FXAA.fx;.config\dotnet-tools.json" Outputs="$(IntermediateOutputPath)FXAA.OpenGL.mgfx">
    <Exec Command="dotnet tool run mgfxc -- &quot;$(MSBuildProjectDirectory)\Resources\FXAA.fx&quot; &quot;$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)FXAA.OpenGL.mgfx', '$(MSBuildProjectDirectory)'))&quot; /Profile:OpenGL" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)XamlEffects.$(ProjectZGraphicsBackend).mgfx" LogicalName="ProjectZ.Resources.XamlEffects.mgfx" />
    <EmbeddedResource Include="$(IntermediateOutputPath)DesktopBlur.$(ProjectZGraphicsBackend).mgfx" LogicalName="ProjectZ.Resources.DesktopBlur.mgfx" />
    <EmbeddedResource Include="$(IntermediateOutputPath)FXAA.OpenGL.mgfx" LogicalName="ProjectZ.Resources.FXAA.mgfx" Condition="'$(ProjectZGraphicsBackend)' == 'OpenGL'" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include=".github\upgrades\scenarios\new-dotnet-version_64215c\plan.md" />
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Include="Resources\FXAA.mgfx" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX12'">
      <LogicalName>ProjectZ.Resources.FXAA.mgfx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\FXAA.dx11.mgfx" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX11'">
      <LogicalName>ProjectZ.Resources.FXAA.mgfx</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Shared\Drawing\Designer\DesignTime\" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.NuGet.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="Images\branding\project-z-icon.png" Pack="true" PackagePath="\" />
    <None Include="ThirdParty\ProjectZSans\OFL.txt;ThirdParty\ProjectZSans\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="ThirdParty\ProjectZSans\" />
    <None Update="THIRD-PARTY-NOTICES.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="Extensions\ProjectZ.Diagnostics.targets" Pack="true" PackagePath="buildTransitive\ProjectZ.targets" />
    <None Include="Project Z XAML Codegen\ProjectZ.NativeXaml.targets" Pack="true" PackagePath="tools\xaml-codegen\ProjectZ.NativeXaml.targets" />
    <None Include="Project Z XAML Codegen\ProjectZ.RenderingQuality.targets" Pack="true" PackagePath="tools\xaml-codegen\ProjectZ.RenderingQuality.targets" />
    <None Include="ThirdParty\WPFPixelShaderLibrary\LICENSE" Pack="true" PackagePath="licenses\WPFPixelShaderLibrary\" />
    <Content Include="ThirdParty\MonoGame.Native\win-x64\mgruntime.dll;ThirdParty\MonoGame.Native\win-x64\runtime.json;ThirdParty\MonoGame.Native\LICENSE*" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX12'">
      <Link>ProjectZ.Native\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Pack>true</Pack>
      <PackagePath>tools\native\win-x64\</PackagePath>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="obj\Debug\net8.0-windows7.0\XamlEffects.DirectX12.mgfx" />
  </ItemGroup>

</Project>
