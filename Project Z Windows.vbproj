<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net8.0-windows7.0</TargetFramework>
	<RootNamespace>ProjectZ</RootNamespace>
	<AssemblyName>ProjectZ</AssemblyName>
	<OptionStrict>On</OptionStrict>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<UseWindowsForms>true</UseWindowsForms>
	<UseWPF>true</UseWPF>
	<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
	<ImplicitUsings>enable</ImplicitUsings>
	<OutputType>Library</OutputType>
	<UseApplicationFramework>True</UseApplicationFramework>
	<SingleInstance>True</SingleInstance>
	<EnableVisualStyles>True</EnableVisualStyles>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<Version>2.8.1.0</Version>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsAsErrors>
    <PackageReleaseNotes>2.8.1 adds opt-in selection and Copy for display text, enforces read-only text boxes without Cut/Paste, and bootstraps generated C#/VB view types for fresh Visual Studio design-time configurations.</PackageReleaseNotes>
	<DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**;Project Z Linux Test\**;Project Z HTML5 Host\**</DefaultItemExcludes>
	<Title>Project Z</Title>
	<Description>An XNA UI Framework that runs on modern .NET 8.0</Description>
	<PackageReadmeFile>README.NuGet.md</PackageReadmeFile>
	<PackageProjectUrl>https://github.com/hheiroww/Project-Z</PackageProjectUrl>
	<ProjectZGraphicsBackend Condition="'$(ProjectZGraphicsBackend)' == ''">DirectX12</ProjectZGraphicsBackend>
	<!-- Published packages must not depend on an unpublished sibling checkout. -->
	<SocketJackProject Condition="'$(UseLocalSocketJack)' == 'true' and '$(SocketJackProject)' == ''">..\..\Documents\GitHub\SocketJack\SocketJack\SocketJack.csproj</SocketJackProject>
	<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeProjectZModelImport</TargetsForTfmSpecificBuildOutput>
	<DefineConstants Condition="'$(ProjectZGraphicsBackend)' == 'DirectX12'">$(DefineConstants),PROJECTZ_DIRECTX12=-1</DefineConstants>
	<DefineConstants Condition="'$(ProjectZGraphicsBackend)' == 'DirectX11'">$(DefineConstants),PROJECTZ_DIRECTX11=-1</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Import fixtures and converter outputs are separate consumers, never framework sources. -->
    <Compile Remove="tests\WpfImport\**;artifacts\**" />
    <Page Remove="tests\WpfImport\**;artifacts\**;Project Z XAML Codegen\**" />
    <EmbeddedResource Remove="tests\WpfImport\**;artifacts\**" />
    <Compile Remove="obj\**" />
    <Compile Remove="packages\**" />
    <Compile Remove="Project Z Application\**" />
    <Compile Remove="Project Z Audio\**" />
    <Compile Remove="Project Z Test\**" />
    <Compile Remove="Project Z Tower Defense\**" />
    <Compile Remove="Project Z Video FX\**" />
    <Compile Remove="Project Z.sln.ide\**" />
    <Compile Remove="ProjectTemplate\**" />
    <Compile Remove="heirowSnap Project Z\**" />
    <Compile Remove="heirowSnap Protocol\**" />
    <Compile Remove="heirowSnap Legacy Settings\**" />
    <None Remove="obj\**" />
    <None Remove="packages\**" />
    <None Remove="Project Z Application\**" />
    <None Remove="Project Z Audio\**" />
    <None Remove="Project Z Test\**" />
    <None Remove="Project Z Tower Defense\**" />
    <None Remove="Project Z Video FX\**" />
    <None Remove="Project Z.sln.ide\**" />
    <None Remove="ProjectTemplate\**" />
    <None Remove="heirowSnap Project Z\**" />
    <None Remove="heirowSnap Protocol\**" />
    <Page Remove="obj\**" />
    <Page Remove="packages\**" />
    <Page Remove="Project Z Tower Defense\**" />
    <Page Remove="heirowSnap Project Z\**" />
    <Page Remove="heirowSnap Protocol\**" />
  </ItemGroup>

  <!-- MonoGame 3.8.5.1 native DX12 is the default. WindowsDX remains available
       as a migration fallback through -p:ProjectZGraphicsBackend=DirectX11. -->
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.5.1" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX12'" />
    <PackageReference Include="MonoGame.Runtime.Windows.DX12" Version="3.8.5.1" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX12'" />
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5.1" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX11'" />
    <PackageReference Include="SocketJack" Version="2026.15.0" Condition="!Exists('$(SocketJackProject)')" />
    <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
    <PackageReference Include="LibTessDotNet" Version="1.1.15" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- Needed by the WindowsDX fallback's SharpDX dependency graph. -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX11'" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX11'" />
  </ItemGroup>

  <Target Name="ValidateProjectZGraphicsBackend" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ProjectZGraphicsBackend)' != 'DirectX12' and '$(ProjectZGraphicsBackend)' != 'DirectX11'" Text="ProjectZGraphicsBackend must be DirectX12 or DirectX11." />
  </Target>

  <ItemGroup Condition="Exists('$(SocketJackProject)')">
    <ProjectReference Include="$(SocketJackProject)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Project Z Model Import\Project Z Model Import.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Ship the internal bridge in ProjectZ instead of requiring a separate package. -->
  <Target Name="IncludeProjectZModelImport">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)ProjectZ.ModelImport.dll" />
    </ItemGroup>
  </Target>

  <!-- Project references retained as project references -->

  <!-- Keep resources -->
  <PropertyGroup>
    <XamlShaderProfile Condition="'$(ProjectZGraphicsBackend)' == 'DirectX12'">DirectX_12</XamlShaderProfile>
    <XamlShaderProfile Condition="'$(ProjectZGraphicsBackend)' == 'DirectX11'">DirectX_11</XamlShaderProfile>
  </PropertyGroup>
  <Target Name="CompileProjectZXamlShaders" BeforeTargets="PrepareResources" Inputs="Resources\XamlEffects.fx;.config\dotnet-tools.json" Outputs="$(IntermediateOutputPath)XamlEffects.$(ProjectZGraphicsBackend).mgfx">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="dotnet tool run mgfxc -- &quot;$(MSBuildProjectDirectory)\Resources\XamlEffects.fx&quot; &quot;$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)XamlEffects.$(ProjectZGraphicsBackend).mgfx', '$(MSBuildProjectDirectory)'))&quot; /Profile:$(XamlShaderProfile) /Defines:$(ProjectZGraphicsBackend.ToUpperInvariant())" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Remove="obj\Debug\net8.0-windows7.0\XamlEffects.DirectX12.mgfx" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)XamlEffects.$(ProjectZGraphicsBackend).mgfx" LogicalName="ProjectZ.Resources.XamlEffects.mgfx" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include=".github\upgrades\scenarios\new-dotnet-version_64215c\plan.md" />
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Include="Resources\FXAA.mgfx" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX12'">
      <LogicalName>ProjectZ.Resources.FXAA.mgfx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\FXAA.dx11.mgfx" Condition="'$(ProjectZGraphicsBackend)' == 'DirectX11'">
      <LogicalName>ProjectZ.Resources.FXAA.mgfx</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Shared\Drawing\Designer\DesignTime\" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Project Z HTML5\index.html" />
    <None Remove="Project Z HTML5\styles.css" />
    <None Remove="Project Z HTML5\src\**\*.js" />
    <Content Include="Project Z HTML5\index.html;Project Z HTML5\styles.css">
      <Pack>True</Pack>
      <PackagePath>contentFiles\any\any\Project Z HTML5\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
    </Content>
    <Content Include="Project Z HTML5\src\**\*.js">
      <Pack>True</Pack>
      <PackagePath>contentFiles\any\any\Project Z HTML5\src\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Update="README.NuGet.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="THIRD-PARTY-NOTICES.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- Include all VB code files by default (SDK-style) -->

</Project>
