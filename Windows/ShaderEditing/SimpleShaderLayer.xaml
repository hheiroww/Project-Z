<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="509" Height="38" Background="Transparent">
    <CheckBox x:Name="Enabled" Canvas.Left="4" Canvas.Top="5" Width="28" Height="28" />
    <Button x:Name="SelectLayer" Canvas.Left="34" Canvas.Top="3" Width="169" Height="30" Content="Layer" />
    <ComboBox x:Name="BlendMode" Canvas.Left="209" Canvas.Top="3" Width="125" Height="30" />
    <Slider x:Name="Opacity" Canvas.Left="341" Canvas.Top="8" Width="112" Height="21"
            Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" />
    <TextBlock x:Name="OpacityLabel" Canvas.Left="457" Canvas.Top="8" Width="51" Height="22" IsHitTestVisible="False" />
</Canvas>
