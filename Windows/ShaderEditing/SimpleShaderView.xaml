<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:z="clr-namespace:ProjectZ.Shared.Drawing.UI.Input"
        Width="650" Height="576" Background="Transparent">
    <Border x:Name="ChannelPanel" Width="106" Height="576" CornerRadius="5" Background="#80212C26" />
    <TextBlock Canvas.Left="12" Canvas.Top="12" Text="Channels" IsHitTestVisible="False" />
    <Button x:Name="ColorChannel" Canvas.Left="8" Canvas.Top="42" Width="90" Height="30" Content="Color" />
    <Button x:Name="AlphaChannel" Canvas.Left="8" Canvas.Top="76" Width="90" Height="30" Content="Alpha" />

    <TextBlock Canvas.Left="123" Canvas.Top="10" Text="Layers" IsHitTestVisible="False" />
    <ComboBox x:Name="AddShader" Canvas.Left="273" Canvas.Top="4" Width="139" Height="32" />
    <Button x:Name="Up" Canvas.Left="419" Canvas.Top="4" Width="56" Height="32" Content="Up" />
    <Button x:Name="Down" Canvas.Left="480" Canvas.Top="4" Width="70" Height="32" Content="Down" />
    <Button x:Name="Remove" Canvas.Left="555" Canvas.Top="4" Width="89" Height="32" Content="Remove" />

    <Border x:Name="LayersPanel" Canvas.Left="117" Canvas.Top="44" Width="533" Height="248" CornerRadius="5" Background="#80212C26" />
    <Canvas x:Name="LayerRows" Canvas.Left="122" Canvas.Top="49" Width="509" Height="238" />
    <z:CollectionScrollBar x:Name="LayerScroll" Canvas.Left="635" Canvas.Top="49" Width="11" Height="238" />

    <Canvas x:Name="Inspector" Canvas.Left="117" Canvas.Top="305" Width="533" Height="220">
        <TextBlock Canvas.Left="6" Text="Shader Properties" IsHitTestVisible="False" />
        <Border x:Name="PropertiesPanel" Canvas.Top="23" Width="533" Height="173" CornerRadius="5" Background="#80212C26" />
        <TextBlock x:Name="ShaderName" Canvas.Left="12" Canvas.Top="30" Width="508" Height="21" IsHitTestVisible="False" />
        <TextBlock x:Name="LayerNameLabel" Canvas.Left="12" Canvas.Top="60" Text="Name" IsHitTestVisible="False" />
        <TextBox x:Name="LayerNameInput" Canvas.Left="117" Canvas.Top="55" Width="403" Height="26" AcceptsReturn="False" />
        <TextBlock x:Name="ValueLabel" Canvas.Left="12" Canvas.Top="89" Width="102" Height="22" IsHitTestVisible="False" />
        <z:DragNumberBox x:Name="ValueInput" Canvas.Left="117" Canvas.Top="84" Width="145" Height="26" />
        <z:RotaryKnob x:Name="ValueKnob" Canvas.Left="272" Canvas.Top="82" Width="30" Height="30" />
        <Canvas x:Name="ColorFields" Canvas.Left="12" Canvas.Top="107" Width="509" Height="88" />
        <TextBlock x:Name="Status" Canvas.Left="6" Canvas.Top="199" Width="520" Height="21" IsHitTestVisible="False" />
    </Canvas>
</Canvas>
