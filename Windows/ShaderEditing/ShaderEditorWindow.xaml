<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1260" Height="740" Background="Transparent">
    <Canvas x:Name="Header" Width="1260" Height="43" Background="#B0102820">
        <TextBlock x:Name="Brand" Canvas.Left="14" Canvas.Top="12" Text="Project-Z" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Canvas.Left="92" Canvas.Top="12" Text="/  Shader Editor" FontSize="16" />
        <TextBlock x:Name="DocumentTitle" Canvas.Left="230" Canvas.Top="14" Width="680" FontSize="13" />
        <Button x:Name="Minimize" Canvas.Left="1134" Canvas.Top="6" Width="36" Height="30" Content="–" />
        <Button x:Name="Maximize" Canvas.Left="1174" Canvas.Top="6" Width="36" Height="30" Content="□" />
        <Button x:Name="Close" Canvas.Left="1214" Canvas.Top="6" Width="36" Height="30" Content="×" />
    </Canvas>
    <Canvas x:Name="Toolbar" Canvas.Top="44" Width="1260" Height="43" Background="#90102820">
        <Button x:Name="New" Canvas.Left="10" Canvas.Top="6" Width="56" Height="30" Content="New" />
        <Button x:Name="Open" Canvas.Left="70" Canvas.Top="6" Width="62" Height="30" Content="Open" />
        <Button x:Name="Save" Canvas.Left="136" Canvas.Top="6" Width="62" Height="30" Content="Save" />
        <Button x:Name="ExportSource" Canvas.Left="202" Canvas.Top="6" Width="84" Height="30" Content="Save .fx" />
        <Button x:Name="ExportEffect" Canvas.Left="290" Canvas.Top="6" Width="108" Height="30" Content="Save .mgfx" />
        <Button x:Name="Undo" Canvas.Left="412" Canvas.Top="6" Width="58" Height="30" Content="Undo" />
        <Button x:Name="Redo" Canvas.Left="474" Canvas.Top="6" Width="58" Height="30" Content="Redo" />
        <Button x:Name="Simple" Canvas.Left="550" Canvas.Top="6" Width="78" Height="30" Content="Simple" />
        <Button x:Name="Advanced" Canvas.Left="632" Canvas.Top="6" Width="98" Height="30" Content="Advanced" />
        <AccentButton x:Name="Presets" Canvas.Left="734" Canvas.Top="6" Width="70" Height="30" Content="Presets" />
        <CheckBox x:Name="AutoRun" Canvas.Left="1056" Canvas.Top="9" Width="94" Height="24" Content="Auto run" />
        <AccentButton x:Name="Run" Canvas.Left="1160" Canvas.Top="6" Width="90" Height="30" Content="▶  Run" />
    </Canvas>
    <Canvas x:Name="Workspace" Canvas.Top="88" Width="950" Height="624" Background="Transparent" ClipToBounds="True" />
    <Canvas x:Name="PreviewRail" Canvas.Left="952" Canvas.Top="88" Width="308" Height="624" Background="#60102820" ClipToBounds="True">
        <TextBlock Canvas.Left="12" Canvas.Top="13" Text="Preview" FontSize="15" FontWeight="SemiBold" />
        <Button x:Name="LoadImage" Canvas.Left="194" Canvas.Top="6" Width="102" Height="29" Content="Load image" />
        <Canvas x:Name="PreviewSurface" Canvas.Left="12" Canvas.Top="42" Width="284" Height="195" Background="#33121D1A" ClipToBounds="True">
            <Image x:Name="Checkerboard" Width="284" Height="195" Stretch="Fill" IsHitTestVisible="False" />
            <Image x:Name="PreviewImage" Width="284" Height="195" Stretch="Uniform" IsHitTestVisible="False" />
        </Canvas>
        <Button x:Name="Play" Canvas.Left="12" Canvas.Top="245" Width="110" Height="29" Content="Play time" />
        <TextBlock x:Name="PreviewTime" Canvas.Left="127" Canvas.Top="252" FontSize="12" Text="0.00 s" />
        <Button x:Name="ResetImage" Canvas.Left="181" Canvas.Top="245" Width="115" Height="29" Content="Reset image" />
        <Button x:Name="DiagnosticsTab" Canvas.Left="12" Canvas.Top="286" Width="110" Height="29" Content="Diagnostics" />
        <Button x:Name="SourceTab" Canvas.Left="126" Canvas.Top="286" Width="102" Height="29" Content="FX source" />
        <TextBox x:Name="CompilerPanel" Canvas.Left="12" Canvas.Top="322" Width="284" Height="290" IsReadOnly="True"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
    </Canvas>
    <Canvas x:Name="Footer" Canvas.Top="714" Width="1260" Height="26" Background="#A0102820">
        <TextBlock x:Name="Status" Canvas.Left="10" Canvas.Top="5" Width="910" FontSize="12" />
        <TextBlock x:Name="Backend" Canvas.Left="1024" Canvas.Top="5" Width="226" FontSize="12" />
    </Canvas>
    <Canvas x:Name="PresetBrowser" Width="584" Height="420" Background="#F0102820" Visibility="Collapsed">
        <TextBlock x:Name="PresetTitle" Canvas.Left="16" Canvas.Top="13" FontSize="17" FontWeight="SemiBold" Text="Shader presets" />
        <Button x:Name="ClosePresets" Canvas.Left="528" Canvas.Top="8" Width="40" Height="30" Content="×" />
        <TextBox x:Name="PresetSearch" Canvas.Left="16" Canvas.Top="49" Width="338" Height="30" AcceptsReturn="False" />
        <TextBlock x:Name="PresetSearchHint" Canvas.Left="23" Canvas.Top="55" Text="Search presets" FontSize="13" IsHitTestVisible="False" />
        <ComboBox x:Name="PresetCategory" Canvas.Left="366" Canvas.Top="49" Width="202" Height="30" />
        <ListBox x:Name="PresetResults" Canvas.Left="16" Canvas.Top="90" Width="552" Height="235" ItemHeight="28" />
        <TextBlock x:Name="PresetDescription" Canvas.Left="16" Canvas.Top="335" Width="552" Height="34" TextWrapping="Wrap" FontSize="13" />
        <TextBlock x:Name="PresetCount" Canvas.Left="16" Canvas.Top="386" Width="380" FontSize="12" />
        <AccentButton x:Name="UsePreset" Canvas.Left="440" Canvas.Top="376" Width="128" Height="32" Content="Load preset" />
    </Canvas>
    <Canvas x:Name="SavePrompt" Canvas.Left="426" Canvas.Top="310" Width="408" Height="120" Background="#F0102820" Visibility="Collapsed">
        <TextBlock Canvas.Left="16" Canvas.Top="16" Width="376" Text="Save changes to this shader graph?" FontSize="16" />
        <Button x:Name="PromptSave" Canvas.Left="107" Canvas.Top="66" Width="90" Height="32" Content="Save" />
        <Button x:Name="PromptDiscard" Canvas.Left="203" Canvas.Top="66" Width="90" Height="32" Content="Discard" />
        <Button x:Name="PromptCancel" Canvas.Left="299" Canvas.Top="66" Width="90" Height="32" Content="Cancel" />
    </Canvas>
</Canvas>
