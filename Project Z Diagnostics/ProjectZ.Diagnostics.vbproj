<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Extensions/ProjectZ.Package.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PackageId>ProjectZ.Diagnostics</PackageId>
    <Description>Optional standalone native crash observer and dump capture for Project-Z applications.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- An explicit manifest declares the runtime dependency without linking
         Windows Desktop into this independently trimmed console observer. -->
    <NuspecFile>ProjectZ.Diagnostics.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version)</NuspecProperties>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <RootNamespace>ProjectZ</RootNamespace>
    <AssemblyName>ProjectZ.Diagnostics</AssemblyName>
    <StartupObject>ProjectZ.RuntimeDiagnostics.ObserverProgram</StartupObject>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RollForward>Major</RollForward>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Windows\Diagnostics\ObserverConnection.vb" Link="ObserverConnection.vb" />
    <Compile Include="..\Windows\Diagnostics\ManagedDiagnosticContext.vb" Link="ManagedDiagnosticContext.vb" />
  </ItemGroup>
  <Target Name="PublishStandaloneObservers" BeforeTargets="GenerateNuspec" DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_ObserverPackDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'observers'))</_ObserverPackDirectory>
      <NuspecProperties>$(NuspecProperties);repositoryCommit=$(SourceRevisionId);observerPackDirectory=$(_ObserverPackDirectory)</NuspecProperties>
    </PropertyGroup>
    <ItemGroup>
      <_ObserverRuntime Include="win-x64;win-arm64" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" RemoveProperties="Platform;PlatformTarget"
             Properties="RuntimeIdentifier=%(_ObserverRuntime.Identity);PublishDir=$(_ObserverPackDirectory)%(_ObserverRuntime.Identity)/" />
  </Target>
</Project>
