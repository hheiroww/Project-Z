<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <RootNamespace>ProjectZ</RootNamespace>
    <AssemblyName>ProjectZ.Diagnostics</AssemblyName>
    <StartupObject>ProjectZ.RuntimeDiagnostics.ObserverProgram</StartupObject>
    <DefineConstants>$(DefineConstants),PROJECTZ_DIAGNOSTICS_OBSERVER=-1</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RollForward>Major</RollForward>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Windows\Diagnostics\ApplicationDiagnostics.vb" Link="ApplicationDiagnostics.vb" />
    <Compile Include="..\Windows\Diagnostics\DiagnosticOptions.vb" Link="DiagnosticOptions.vb" />
  </ItemGroup>
</Project>
