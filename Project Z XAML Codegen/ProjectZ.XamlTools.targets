<Project>
  <PropertyGroup>
    <ProjectZXamlGeneratorDll Condition="'$(ProjectZXamlGeneratorDll)' == ''">$(MSBuildThisFileDirectory)../tools/xaml-codegen/ProjectZ.XamlCodegen.dll</ProjectZXamlGeneratorDll>
    <ProjectZNativeXamlTool Condition="'$(ProjectZNativeXamlTool)' == '' or (!Exists('$(ProjectZNativeXamlTool)') and !Exists('$(ProjectZNativeXamlToolProject)'))">$(ProjectZXamlGeneratorDll)</ProjectZNativeXamlTool>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../tools/xaml-codegen/ProjectZ.NativeXaml.targets"
          Condition="'$(ProjectZNativeXamlIntegrationImported)' != 'true'" />
</Project>
