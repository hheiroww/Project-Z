<Project>
  <!-- Direct framework references use the same base-runtime deployment rules as
       NuGet consumers. Native crash capture is an optional co-package. -->
  <PropertyGroup>
    <ProjectZSourceReference>@(ProjectReference->WithMetadataValue('Filename', 'Project Z Windows'))</ProjectZSourceReference>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)Extensions/ProjectZ.Diagnostics.targets"
          Condition="'$(ProjectZSourceReference)' != '' or '$(MSBuildProjectName)' == 'Project Z Windows'" />
  <!-- Repository consumers get the settings page, but conversion remains off until explicitly enabled.
       Runtime and tool projects build independently of consumer conversion settings. -->
  <Import Project="$(MSBuildThisFileDirectory)Project Z XAML Codegen/ProjectZ.Xaml.targets"
          Condition="'$(ProjectZXamlIntegrationImported)' != 'true' and '$(MSBuildProjectName)' != 'Project Z Windows' and '$(MSBuildProjectName)' != 'ProjectZ.WpfCompatibility' and '$(MSBuildProjectName)' != 'ProjectZ.XamlCodegen' and '$(MSBuildProjectName)' != 'ProjectZ.Diagnostics' and '$(MSBuildProjectName)' != 'Project Z Model Import' and '$(MSBuildProjectName)' != 'ProjectZ.VectorText' and '$(MSBuildProjectName)' != 'ProjectZ.WebView2'" />
</Project>
