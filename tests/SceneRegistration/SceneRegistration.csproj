<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF><PlatformTarget>x64</PlatformTarget><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ProjectZRegressionVersion Condition="'$(ProjectZRegressionVersion)' == ''">2026.10.20.2</ProjectZRegressionVersion>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="ProjectZ" Version="[$(ProjectZRegressionVersion)]" /></ItemGroup>
</Project>
