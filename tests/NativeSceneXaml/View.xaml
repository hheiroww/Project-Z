<SceneTemplates xmlns="urn:projectz:native-scene" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Class="Fixture.View">
  <Using>System</Using>
  <Using>Microsoft.Xna.Framework</Using>
  <Resource x:Name="Heading" Type="string" Value="Native XAML" />
  <Factory x:Name="Button" Returns="Control" Attach="Attach">
    <Parameter Name="text" Attribute="Text" Type="string" />
    <Parameter Name="action" Attribute="Click" Type="Action" />
    <Parameter Name="width" Attribute="Width" Type="float" Default="42" />
    <Element Type="Control">
      <Set Property="Text" Type="string" Value="{Parameter text}" />
      <Set Property="Width" Type="float" Value="{Parameter width}" />
      <Event Name="Click" Action="{Parameter action}" When="element.Enabled" />
    </Element>
  </Factory>
  <Button x:Name="CreateHeading" Factory="Button" Text="{Resource Heading}" Width="240" Height="30" Font="fixture_22" BackgroundBlur="12" DropDownBackgroundBlur="0" Cursor="Arrow" Click="{Parameter action}">
    <Parameter Name="action" Type="Action" />
  </Button>
  <Button x:Name="CreateInheritedBlur" Factory="Button" Text="Inherited" BackgroundBlur="24" DropDownBackgroundBlur="{x:Null}" Cursor="{x:Null}" Click="{Parameter action}">
    <Parameter Name="action" Type="Action" />
  </Button>
  <Button x:Name="CreatePhysics" Factory="Button" Text="Physics" Click="{Parameter action}" RigidBody="true" FreeMove="true" CollisionEnabled="true" Weight="4.5" Bounce="0.35" Friction="0.2" FrictionType="Ice" PhysicsMotion="RenderTranslation" Gravity="0, 980" Velocity="120, -15" Velocity3D="1, 2, 3" Gravity3D="0, -9.81, 0" Position3D="-1, 0, 2" PhysicsSize3D="2, 3, 4">
    <Parameter Name="action" Type="Action" />
  </Button>
  <Button x:Name="CreatePhysicsAlias" Factory="Button" Text="Physics alias" Click="{Parameter action}" RidgidBody="true" Mass="2" PhysicsMotion="Position">
    <Parameter Name="action" Type="Action" />
  </Button>
  <ObjectFactory x:Name="CreateObject" Type="Control">
    <Parameter Name="width" Type="System.Func&lt;float&gt;" />
    <Argument Type="View" Value="{Expression this}" />
    <Set Property="Text" Type="string" Value="Object from XAML" />
    <Set Property="Width" Type="float" Value="{Expression width()}" />
  </ObjectFactory>
  <Button x:Name="AdditionalLabel" Factory="Button" AutoCreate="true" Page="Home" Text="Added in XAML" Width="80" Click="{Expression () =&gt; { }}" />
</SceneTemplates>
