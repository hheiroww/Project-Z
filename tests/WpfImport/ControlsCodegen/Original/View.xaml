<UserControl x:Class="ControlsCodegen.View" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="680" Height="430">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary><SolidColorBrush x:Key="MergedTone" Color="Cyan"/></ResourceDictionary></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    <Style x:Key="NativeButton" TargetType="Button">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="Lime"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="Yellow"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel x:Name="DockRoot" LastChildFill="True">
    <TextBlock x:Name="Caption" DockPanel.Dock="Top" Height="36" FontFamily="Arial" FontSize="20" FontWeight="Bold" Foreground="Lime" TextAlignment="Center" Text="Generated vector text"><TextBlock.TextDecorations><TextDecorationCollection><TextDecoration Location="Underline"/></TextDecorationCollection></TextBlock.TextDecorations></TextBlock>
    <ListView x:Name="Files" DockPanel.Dock="Left" Width="150" Margin="2"><ListView.View><GridView><GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding Content}"/></GridView></ListView.View><ListViewItem x:Name="First" Content="One"/><ListViewItem Content="Two"/></ListView>
    <Grid>
      <Grid.RowDefinitions><RowDefinition x:Name="MainRow" Height="*"/></Grid.RowDefinitions>
      <Button x:Name="Action" Style="{StaticResource NativeButton}" Width="140" Height="36" VerticalAlignment="Top" HorizontalAlignment="Left" Background="Blue" Foreground="White" BorderBrush="Red" BorderThickness="2" FontFamily="Arial" FontSize="18" VerticalContentAlignment="Center" IsDefault="True" Content="Generated" Click="OnAction"/>
      <RichTextBox x:Name="Editor" Margin="0,90,0,100" AcceptsReturn="True"><FlowDocument PagePadding="0"><Paragraph><Run Text="Markup input"/></Paragraph></FlowDocument></RichTextBox>
      <Polygon x:Name="Triangle" Width="60" Height="60" HorizontalAlignment="Right" VerticalAlignment="Top" Points="0,0 60,0 30,60" Fill="Yellow"/>
      <Image x:Name="Picture" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,0,0" Stretch="Fill"/>
      <Border x:Name="Rotated" Width="80" Height="24" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Background="Magenta" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="90"/></Border.RenderTransform></Border>
      <Border x:Name="Clipped" Width="80" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Background="Cyan" ClipToBounds="True" AutomationProperties.Name="Clipped region" AutomationProperties.HelpText="Native clipping"><Border.Clip><RectangleGeometry Rect="0,0,40,24"/></Border.Clip></Border>
      <Border Width="20" Height="20" HorizontalAlignment="Center" Background="{StaticResource MergedTone}"><Border.RenderTransform><TransformGroup><ScaleTransform ScaleX="1.1" ScaleY="1.1"/><TranslateTransform X="2"/></TransformGroup></Border.RenderTransform><Border.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard AutoReverse="True"><DoubleAnimation To="0.5" Duration="0:0:0.5" Storyboard.TargetProperty="Opacity"/></Storyboard></BeginStoryboard></EventTrigger></Border.Triggers></Border>
      <ContentPresenter x:Name="Unsupported" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Must be empty"/>
      <TabControl x:Name="BlankTabs" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" ItemsSource="{Binding Missing}">
        <TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><ContentPresenter Content="Blank template"/></ControlTemplate></Setter.Value></Setter></Style></TabControl.ItemContainerStyle>
        <TabItem Header="Invisible tab"><TabItem.Content><TextBlock x:Name="BlankChild" Text="Hidden content"/></TabItem.Content></TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
