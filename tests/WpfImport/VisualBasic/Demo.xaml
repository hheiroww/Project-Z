<Window x:Class="Demo" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="640" Height="400">
  <StackPanel Width="500" Height="350">
    <TextBox x:Name="Editor" Width="360" Height="40" Text="{Binding Person.Name, Mode=TwoWay}" />
    <TextBlock x:Name="Label" Width="360" Height="40" Text="{Binding Person.Name}" />
    <Button x:Name="Save" Width="200" Height="45" Content="Save VB" />
  </StackPanel>
</Window>
