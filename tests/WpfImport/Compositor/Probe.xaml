<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" Height="200" Title="Project-Z compositor fixture" Background="Transparent" ShowActivated="False" ShowInTaskbar="False">
  <Window.Resources>
    <LinearGradientBrush x:Key="Stroke" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#80FF0000" Offset="0" />
      <GradientStop Color="#8000FF00" Offset="1" />
    </LinearGradientBrush>
  </Window.Resources>
  <Border Background="#000040">
    <Canvas x:Name="Root">
      <Border x:Name="MarkupSquare" Canvas.Left="10" Canvas.Top="10" Width="45" Height="40" Background="#80FF0000" />
      <Border x:Name="MarkupRound" Canvas.Left="60" Canvas.Top="10" Width="45" Height="40" Background="#80FF0000" CornerRadius="6" />
      <Border x:Name="MarkupOpacity" Canvas.Left="110" Canvas.Top="10" Width="45" Height="40" Background="#FF0000" Opacity="0.5" />
      <Grid Canvas.Left="160" Canvas.Top="10" Width="45" Height="40" Opacity="0.5">
        <Border x:Name="AncestorOpacity" Background="#FF0000" />
      </Grid>
      <ScrollViewer x:Name="ExplicitTransparentScroll" Canvas.Left="10" Canvas.Top="62" Width="45" Height="40" Background="Transparent" />
      <ScrollViewer x:Name="ImplicitTransparentScroll" Canvas.Left="60" Canvas.Top="62" Width="45" Height="40" />
      <Border x:Name="GradientStroke" Canvas.Left="10" Canvas.Top="117" Width="96" Height="49" BorderThickness="5" CornerRadius="6"
              Background="#001144" BorderBrush="{StaticResource Stroke}" />
    </Canvas>
  </Border>
</Window>
