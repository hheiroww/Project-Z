<Window x:Class="TextLayout.ProbeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="300" Height="200">
  <StackPanel>
    <TextBlock x:Name="Wrapped" Text="ABCDEFGHIJKLMNOPQRSTUVWXYZ" Width="80" FontSize="12" TextWrapping="Wrap" />
    <TextBlock x:Name="Overflow" Text="ABCDEFGHIJKLMNOPQRSTUVWXYZ" Width="80" FontSize="12" TextWrapping="WrapWithOverflow" />
    <TextBlock x:Name="Trimmed" Text="Several words must be trimmed within this narrow line" Width="80" Height="20" FontSize="12" TextTrimming="WordEllipsis" TextWrapping="NoWrap" />
    <TextBlock x:Name="Typeface" Text="WWW ✕ ▾ …" FontFamily="Consolas" FontWeight="Bold" FontSize="16" TextWrapping="NoWrap" />
  </StackPanel>
</Window>
