<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ProjectZ.Diagnostics.Consumer</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <ProjectZPackageVersion Condition="'$(ProjectZPackageVersion)' == ''">2.8.4</ProjectZPackageVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseProjectZSource)' != 'true'"><PackageReference Include="ProjectZ" Version="$(ProjectZPackageVersion)" /></ItemGroup>
  <ItemGroup Condition="'$(UseProjectZSource)' == 'true'"><ProjectReference Include="..\..\..\Project Z Windows.vbproj" /></ItemGroup>
</Project>
