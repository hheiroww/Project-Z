<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="1040" Height="700" d:DesignWidth="1040" d:DesignHeight="700" mc:Ignorable="d">
    <Grid Width="1040" Height="700" Background="#0B1017">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="78" />
            <RowDefinition Height="360" />
            <RowDefinition Height="132" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172433" />
        <TextBlock Grid.Row="0" Margin="28,14,0,0" VerticalAlignment="Top" FontSize="29"
                   FontWeight="SemiBold" Foreground="#F5F8FC" Text="PROJECT Z GRANULIZER" />
        <TextBlock Grid.Row="0" Margin="700,23,0,0" VerticalAlignment="Top" FontSize="14"
                   Foreground="#25E1C5" Text="DIRECTX 11 - GRANULAR SYNTH" />

        <Grid Grid.Row="1" Background="#101923">
            <TextBlock Margin="28,12,0,0" VerticalAlignment="Top" FontSize="12" Foreground="#7890A8" Text="SOURCE / MODULATOR" />
            <Button x:Name="LoadAudioButton" Width="130" Height="34" Margin="28,32,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#23374A" Foreground="#FFFFFF" Content="LOAD SOUND" />
            <Button x:Name="LoadImageButton" Width="130" Height="34" Margin="170,32,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#23374A" Foreground="#FFFFFF" Content="LOAD PICTURE" />
            <Button x:Name="LoadTextButton" Width="130" Height="34" Margin="312,32,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#23374A" Foreground="#FFFFFF" Content="LOAD TEXT" />
            <TextBlock x:Name="ProfileNameText" Margin="470,23,20,0" VerticalAlignment="Top" FontSize="18" Foreground="#25E1C5" Text="Warm harmonic wave" />
        </Grid>

        <Grid Grid.Row="2" Margin="20,12,20,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="500" /><ColumnDefinition Width="500" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="68" /><RowDefinition Height="68" /><RowDefinition Height="68" />
                <RowDefinition Height="68" /><RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="8,4,0,0" FontSize="14" Foreground="#B9C7D7" Text="GRAIN SIZE" />
            <Slider x:Name="GrainSizeSlider" Grid.Row="0" Grid.Column="0" Width="330" Height="32" Margin="132,0,0,0" HorizontalAlignment="Left" Minimum="5" Maximum="500" Value="85" />
            <TextBlock x:Name="GrainSizeValue" Grid.Row="0" Grid.Column="0" Margin="0,4,8,0" HorizontalAlignment="Right" FontSize="14" Foreground="#FFFFFF" Text="85 ms" />

            <TextBlock Grid.Row="0" Grid.Column="1" Margin="20,4,0,0" FontSize="14" Foreground="#B9C7D7" Text="DENSITY" />
            <Slider x:Name="DensitySlider" Grid.Row="0" Grid.Column="1" Width="330" Height="32" Margin="132,0,0,0" HorizontalAlignment="Left" Minimum="1" Maximum="120" Value="22" />
            <TextBlock x:Name="DensityValue" Grid.Row="0" Grid.Column="1" Margin="0,4,8,0" HorizontalAlignment="Right" FontSize="14" Foreground="#FFFFFF" Text="22/s" />

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="8,4,0,0" FontSize="14" Foreground="#B9C7D7" Text="POSITION" />
            <Slider x:Name="PositionSlider" Grid.Row="1" Grid.Column="0" Width="330" Height="32" Margin="132,0,0,0" HorizontalAlignment="Left" Minimum="0" Maximum="100" Value="50" />
            <TextBlock x:Name="PositionValue" Grid.Row="1" Grid.Column="0" Margin="0,4,8,0" HorizontalAlignment="Right" FontSize="14" Foreground="#FFFFFF" Text="50%" />

            <TextBlock Grid.Row="1" Grid.Column="1" Margin="20,4,0,0" FontSize="14" Foreground="#B9C7D7" Text="SPRAY" />
            <Slider x:Name="SpraySlider" Grid.Row="1" Grid.Column="1" Width="330" Height="32" Margin="132,0,0,0" HorizontalAlignment="Left" Minimum="0" Maximum="100" Value="28" />
            <TextBlock x:Name="SprayValue" Grid.Row="1" Grid.Column="1" Margin="0,4,8,0" HorizontalAlignment="Right" FontSize="14" Foreground="#FFFFFF" Text="28%" />

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="8,4,0,0" FontSize="14" Foreground="#B9C7D7" Text="PITCH" />
            <Slider x:Name="PitchSlider" Grid.Row="2" Grid.Column="0" Width="330" Height="32" Margin="132,0,0,0" HorizontalAlignment="Left" Minimum="-24" Maximum="24" Value="0" />
            <TextBlock x:Name="PitchValue" Grid.Row="2" Grid.Column="0" Margin="0,4,8,0" HorizontalAlignment="Right" FontSize="14" Foreground="#FFFFFF" Text="0 st" />

            <TextBlock Grid.Row="2" Grid.Column="1" Margin="20,4,0,0" FontSize="14" Foreground="#B9C7D7" Text="TABLE DEPTH" />
            <Slider x:Name="TableDepthSlider" Grid.Row="2" Grid.Column="1" Width="330" Height="32" Margin="132,0,0,0" HorizontalAlignment="Left" Minimum="0" Maximum="100" Value="55" />
            <TextBlock x:Name="TableDepthValue" Grid.Row="2" Grid.Column="1" Margin="0,4,8,0" HorizontalAlignment="Right" FontSize="14" Foreground="#FFFFFF" Text="55%" />

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="8,4,0,0" FontSize="14" Foreground="#B9C7D7" Text="STEREO" />
            <Slider x:Name="StereoSlider" Grid.Row="3" Grid.Column="0" Width="330" Height="32" Margin="132,0,0,0" HorizontalAlignment="Left" Minimum="0" Maximum="100" Value="65" />
            <TextBlock x:Name="StereoValue" Grid.Row="3" Grid.Column="0" Margin="0,4,8,0" HorizontalAlignment="Right" FontSize="14" Foreground="#FFFFFF" Text="65%" />

            <TextBlock Grid.Row="3" Grid.Column="1" Margin="20,4,0,0" FontSize="14" Foreground="#B9C7D7" Text="LEVEL" />
            <Slider x:Name="LevelSlider" Grid.Row="3" Grid.Column="1" Width="330" Height="32" Margin="132,0,0,0" HorizontalAlignment="Left" Minimum="0" Maximum="100" Value="100" />
            <TextBlock x:Name="LevelValue" Grid.Row="3" Grid.Column="1" Margin="0,4,8,0" HorizontalAlignment="Right" FontSize="14" Foreground="#FFFFFF" Text="100%" />

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="8,4,0,0" FontSize="14" Foreground="#B9C7D7" Text="OUTPUT" />
            <Slider x:Name="OutputSlider" Grid.Row="4" Grid.Column="0" Width="330" Height="32" Margin="132,0,0,0" HorizontalAlignment="Left" Minimum="-24" Maximum="12" Value="0" />
            <TextBlock x:Name="OutputValue" Grid.Row="4" Grid.Column="0" Margin="0,4,8,0" HorizontalAlignment="Right" FontSize="14" Foreground="#FFFFFF" Text="0 dB" />

            <CheckBox x:Name="HoldCheckBox" Grid.Row="4" Grid.Column="1" Margin="24,7,0,0" Foreground="#DCE7F3" Content="HOLD NOTES" IsChecked="False" />
            <CheckBox x:Name="MuteCheckBox" Grid.Row="4" Grid.Column="1" Margin="210,7,0,0" Foreground="#DCE7F3" Content="MUTE" IsChecked="False" />
            <Button x:Name="ResetButton" Grid.Row="4" Grid.Column="1" Width="92" Height="32" Margin="0,0,8,0" HorizontalAlignment="Right" Background="#263B4F" Foreground="#FFFFFF" Content="RESET" />
        </Grid>

        <Grid Grid.Row="3" Margin="20,4,20,6" Background="#121D28">
            <TextBlock Margin="14,9,0,0" VerticalAlignment="Top" FontSize="12" Foreground="#7890A8" Text="SOCKETJACK LLM RUNTIME - DESCRIBE A SOUND / PROFILE" />
            <TextBox x:Name="PromptTextBox" Width="790" Height="42" Margin="14,36,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#0A1119" Foreground="#F5F8FC" Text="glassy evolving choir with scattered metallic grains" />
            <Button x:Name="GenerateButton" Width="150" Height="42" Margin="0,36,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#127E76" Foreground="#FFFFFF" Content="GENERATE PROFILE" />
            <TextBlock x:Name="StatusText" Margin="14,88,14,0" VerticalAlignment="Top" FontSize="12" Foreground="#8EA4B9" Text="Ready - play MIDI notes to generate sound" />
        </Grid>

        <Border Grid.Row="4" Background="#070B10" />
        <TextBlock Grid.Row="4" Margin="28,17,0,0" VerticalAlignment="Top" FontSize="12" Foreground="#63798E" Text="Drop WAV, MP3, pictures, text or any file - XAML designer editable - GPU accelerated editor" />
    </Grid>
</UserControl>
