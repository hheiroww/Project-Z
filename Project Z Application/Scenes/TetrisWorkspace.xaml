<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="950" Height="650" Background="Transparent">
    <Border x:Name="Header" Width="950" Height="46" IsHitTestVisible="False" />
    <Border x:Name="Sidebar" Canvas.Left="16" Canvas.Top="66" Width="296" Height="563" CornerRadius="6" IsHitTestVisible="False" />

    <TextBlock x:Name="AppTitle" Canvas.Left="17" Canvas.Top="10" Text="Project-Z" FontSize="18" IsHitTestVisible="False" />
    <Button x:Name="Minimize" Canvas.Left="851" Canvas.Top="6" Width="42" Height="34" Content="—" CornerRadius="4" />
    <Button x:Name="Close" Canvas.Left="900" Canvas.Top="6" Width="42" Height="34" Content="×" CornerRadius="4" />

    <TextBlock x:Name="WorkspaceLabel" Canvas.Left="34" Canvas.Top="87" Text="Workspace" FontSize="14" IsHitTestVisible="False" />
    <TextBlock x:Name="Heading" Canvas.Left="34" Canvas.Top="116" Text="Tetris" FontSize="26" IsHitTestVisible="False" />
    <Button x:Name="OpenEditor" Canvas.Left="34" Canvas.Top="168" Width="260" Height="34" Content="Shader Editor" CornerRadius="4" />
    <Button x:Name="ResetEffect" Canvas.Left="34" Canvas.Top="210" Width="260" Height="34" Content="Reset effect" CornerRadius="4" />
    <TextBlock x:Name="EffectStatus" Canvas.Left="34" Canvas.Top="260" Width="260" Height="35"
               Text="Run a shader to apply it to this board." TextWrapping="Wrap" FontSize="14" IsHitTestVisible="False" />
    <TextBlock x:Name="ScoreLabel" Canvas.Left="34" Canvas.Top="397" Text="Score 0  ·  Lines 0" FontSize="16" IsHitTestVisible="False" />
    <TextBlock x:Name="MoveHelp" Canvas.Left="34" Canvas.Top="433" Text="Arrow keys to move and rotate" FontSize="14" IsHitTestVisible="False" />
    <TextBlock x:Name="DropHelp" Canvas.Left="34" Canvas.Top="457" Text="Space drops · P pauses · R restarts" FontSize="14" IsHitTestVisible="False" />
    <Button x:Name="Theme" Canvas.Left="34" Canvas.Top="578" Width="260" Height="34" Content="Theme  ·  Forest" CornerRadius="4" />
</Canvas>
