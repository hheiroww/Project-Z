<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Test</RootNamespace>
    <AssemblyName>ProjectZ.DesktopSample</AssemblyName>
    <OutputType>Exe</OutputType>
    <OptionStrict>On</OptionStrict>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <StartupObject>Test.Program</StartupObject>
    <ProjectZDesktopPlatform Condition="'$(ProjectZDesktopPlatform)' == ''">Linux</ProjectZDesktopPlatform>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.vb;zWindow.vb;Scenes/MainScene.vb" />
    <ProjectReference Include="../Project Z Linux/ProjectZ.Linux.vbproj" Condition="'$(ProjectZDesktopPlatform)' == 'Linux'" />
    <ProjectReference Include="../Project Z macOS/ProjectZ.macOS.vbproj" Condition="'$(ProjectZDesktopPlatform)' == 'macOS'" />
  </ItemGroup>
  <Target Name="ValidateDesktopPlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ProjectZDesktopPlatform)' != 'Linux' and '$(ProjectZDesktopPlatform)' != 'macOS'" Text="ProjectZDesktopPlatform must be Linux or macOS." />
  </Target>
</Project>
