<Window x:Class="$ext_safeprojectname$.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project-Z XAML" Width="960" Height="600"
        Background="#121923" Foreground="White">
  <StackPanel Margin="48">
    <TextBlock x:Name="Welcome" Text="Welcome to Project-Z XAML" FontSize="28" Margin="0,0,0,20" />
    <TextBlock Text="Edit this view in the Designer project, then build and run the App project."
               FontSize="16" TextWrapping="Wrap" Margin="0,0,0,24" />
    <Button x:Name="RunButton" Content="Run shared event handler" Click="Run_Click"
            Width="300" Height="48" HorizontalAlignment="Left" Margin="0,0,0,20" />
    <TextBlock x:Name="Status" Text="Ready" FontSize="18" />
  </StackPanel>
</Window>
