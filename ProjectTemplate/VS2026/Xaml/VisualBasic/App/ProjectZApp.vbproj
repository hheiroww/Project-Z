<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace></RootNamespace>
    <AssemblyName>$safeprojectname$</AssemblyName>
    <StartupObject>$ext_safeprojectname$.Program</StartupObject>
    <ProjectZXamlMode>DesignerAndCodeBehind</ProjectZXamlMode>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>
  <ItemGroup>
    <ProjectZXaml Include="../$ext_safeprojectname$.Designer/MainWindow.xaml" Link="Views/MainWindow.xaml" />
    <Compile Include="../$ext_safeprojectname$.Designer/MainWindow.xaml.vb" Link="Views/MainWindow.xaml.vb" />
    <ProjectZXamlSource Include="../$ext_safeprojectname$.Designer/MainWindow.xaml.vb" />
  </ItemGroup>
  <Import Project="ProjectZ/ProjectZ.Tooling.props" />
  <Import Project="ProjectZ/ProjectZ.Graphics.props" />
  <Import Project="ProjectZ/ProjectZ.Graphics.targets" />
  <Import Project="ProjectZ/ProjectZ.Xaml.targets" />
</Project>
